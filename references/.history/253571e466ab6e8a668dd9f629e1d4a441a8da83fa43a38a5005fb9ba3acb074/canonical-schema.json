{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "authority": "Frozen accepted downstream contract",
  "encoding": {
    "ensure_ascii": false,
    "final_newline": true,
    "indent": 2,
    "sort_keys": true
  },
  "scope": "Stage output contracts; nested renderer structures are governed by frozen renderer/renderer-input.schema.json",
  "version": 18,
  "stages": {
    "S0": {},
    "S1": {
      "facts/blocks.json": {
        "additionalProperties": {
          "additionalProperties": true,
          "properties": {
            "basic_block": {
              "type": "integer"
            },
            "is_cleanup": {
              "type": "boolean"
            },
            "statements": {
              "items": {},
              "type": "array"
            },
            "terminator": {
              "additionalProperties": true,
              "properties": {
                "kind": {
                  "type": "string"
                },
                "successors": {
                  "items": {
                    "type": "integer"
                  },
                  "type": "array"
                }
              },
              "required": [
                "kind",
                "successors"
              ],
              "type": "object"
            }
          },
          "required": [
            "basic_block",
            "is_cleanup",
            "statements",
            "terminator"
          ],
          "type": "object"
        },
        "type": "object"
      },
      "facts/edges.json": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "bindingRef": {
              "type": "string"
            },
            "condition": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "source_info": {},
            "successor_index": {
              "type": "integer"
            },
            "target": {
              "type": "string"
            },
            "terminator_kind": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "source",
            "target",
            "condition",
            "terminator_kind",
            "successor_index",
            "source_info"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "facts/call-bindings.json": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "bb": {
              "type": "string"
            },
            "callee": {
              "type": "object"
            },
            "destination": {},
            "func": {
              "type": "object"
            },
            "id": {
              "type": "string"
            },
            "normal_successor": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_info": {},
            "unwind": {}
          },
          "required": [
            "id",
            "bb",
            "callee",
            "func",
            "destination",
            "normal_successor",
            "unwind",
            "source_info"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "facts/async-states.json": {
        "additionalProperties": false,
        "properties": {
          "dispatch": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_coroutine": {
            "type": "boolean"
          },
          "states": {
            "items": {
              "additionalProperties": true,
              "properties": {},
              "required": [
                "value",
                "entry",
                "role"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "is_coroutine",
          "dispatch",
          "states"
        ],
        "type": "object"
      },
      "facts/terminal-events.json": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "source_info": {}
          },
          "required": [
            "id",
            "kind",
            "source",
            "source_info"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "facts/summary.json": {
        "additionalProperties": false,
        "properties": {
          "bb_count": {
            "type": "integer"
          },
          "call_count": {
            "type": "integer"
          },
          "edge_count": {
            "type": "integer"
          },
          "locals_count": {
            "type": "integer"
          },
          "terminal_event_count": {
            "type": "integer"
          },
          "terminators": {
            "type": "object"
          }
        },
        "required": [
          "bb_count",
          "edge_count",
          "call_count",
          "terminal_event_count",
          "locals_count",
          "terminators"
        ],
        "type": "object"
      },
      "facts/elements.json": {
        "properties": {
          "items": {
            "items": {
              "properties": {
                "id": {
                  "minLength": 1,
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "bb",
                    "call",
                    "body",
                    "switch"
                  ]
                }
              },
              "required": [
                "id",
                "kind"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "schemaVersion": {
            "const": 1
          }
        },
        "required": [
          "schemaVersion",
          "ownerDefPathHash",
          "items"
        ],
        "type": "object"
      }
    },
    "S2": {
      "stage2/hierarchy.json": {
        "additionalProperties": false,
        "properties": {
          "nodes": {
            "additionalProperties": {
              "additionalProperties": true,
              "properties": {
                "basic_block_refs": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "children": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "depth": {
                  "type": "number"
                },
                "id": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "root",
                    "phase",
                    "goal",
                    "action",
                    "bb_group",
                    "technical_group",
                    "bb"
                  ]
                },
                "reading_parent": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "kind",
                "depth",
                "children",
                "reading_parent",
                "basic_block_refs"
              ],
              "type": "object"
            },
            "type": "object"
          },
          "phase_order": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "root": {
            "type": "string"
          },
          "semantic_action_ids": {
            "type": "object"
          }
        },
        "required": [
          "root",
          "phase_order",
          "nodes"
        ],
        "type": "object"
      },
      "stage2/selection.json": {
        "properties": {
          "foldRules": {
            "items": {
              "properties": {
                "reason": {
                  "minLength": 1,
                  "type": "string"
                },
                "targetCategory": {
                  "enum": [
                    "std",
                    "third_party"
                  ]
                }
              },
              "required": [
                "targetCategory",
                "reason"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "items": {
            "items": {
              "properties": {
                "disposition": {
                  "enum": [
                    "shown",
                    "technical",
                    "folded"
                  ]
                },
                "id": {
                  "minLength": 1,
                  "type": "string"
                },
                "ownerActionRef": {
                  "type": "string"
                },
                "reason": {
                  "minLength": 1,
                  "type": "string"
                },
                "semanticRole": {
                  "enum": [
                    "business",
                    "adapter"
                  ]
                },
                "sourceRefs": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "id",
                "disposition"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "stage2/granularity.json": {
        "properties": {
          "technicalBlocks": {
            "items": {
              "required": [
                "bbRef",
                "category",
                "reason",
                "evidenceRefs",
                "factSha256"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "technicalIntervals": {
            "items": {
              "properties": {
                "bbRef": {
                  "type": "string"
                },
                "statementIndices": {
                  "items": {
                    "type": "integer"
                  },
                  "type": "array"
                },
                "terminator": {
                  "type": "boolean"
                }
              },
              "required": [
                "bbRef",
                "statementIndices",
                "terminator"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "technicalBlocks",
          "technicalIntervals"
        ],
        "type": "object"
      },
      "stage2/blocks-ledger.tsv": {
        "columns": [
          "bb",
          "direct_parent",
          "full_path",
          "factual_operations",
          "real_exits"
        ],
        "format": "tsv"
      },
      "stage2/model-check.json": {
        "properties": {
          "ownerContradictions": {
            "const": 0
          },
          "passed": {
            "const": true
          },
          "unaccountedCalls": {
            "const": 0
          }
        },
        "required": [
          "passed",
          "unaccountedCalls",
          "ownerContradictions"
        ],
        "type": "object"
      }
    },
    "S3": {
      "stage3/review.json": {
        "type": [
          "object",
          "array"
        ]
      },
      "stage3/review.md": {
        "format": "authored-text"
      },
      "stage3/lock.json": {
        "properties": {
          "passed": {
            "const": true
          },
          "sha256": {
            "type": "object"
          }
        },
        "required": [
          "passed",
          "sha256"
        ],
        "type": "object"
      }
    },
    "S4": {
      "stage4/edges.json": {
        "description": "Authored edge records and optional transitions retained without information loss; renderer projection reads edges only.",
        "type": [
          "array",
          "object"
        ]
      },
      "stage4/presentation.json": {
        "additionalProperties": true,
        "properties": {
          "branchRoles": {
            "type": "array"
          },
          "controlEvidence": {
            "type": "object"
          },
          "controls": {
            "items": {},
            "type": "array"
          },
          "executionEdges": {
            "items": {},
            "type": "array"
          },
          "executionNodes": {
            "items": {},
            "type": "array"
          },
          "ownerControls": {
            "type": "object"
          },
          "returnContracts": {
            "type": "array"
          }
        },
        "required": [
          "controls",
          "executionNodes",
          "executionEdges",
          "ownerControls",
          "controlEvidence",
          "branchRoles",
          "returnContracts"
        ],
        "type": "object"
      }
    },
    "S5": {
      "stage5/external.json": {
        "additionalProperties": true,
        "properties": {
          "actors": {
            "items": {},
            "type": "array"
          },
          "business_members": {
            "items": {},
            "type": "array"
          },
          "messages": {
            "items": {},
            "type": "array"
          },
          "purposeProjections": {
            "items": {},
            "type": "array"
          }
        },
        "required": [
          "actors",
          "messages",
          "business_members",
          "purposeProjections"
        ],
        "type": "object"
      },
      "stage5/model-check.json": {
        "properties": {
          "ownerContradictions": {
            "const": 0
          },
          "passed": {
            "const": true
          },
          "unaccountedCalls": {
            "const": 0
          }
        },
        "required": [
          "passed",
          "unaccountedCalls",
          "ownerContradictions"
        ],
        "type": "object"
      }
    },
    "S6": {
      "renderer-input.json": {
        "additionalProperties": true,
        "properties": {},
        "required": [
          "profile",
          "semanticRoot",
          "phases",
          "messages",
          "execution",
          "functionSource"
        ],
        "type": "object"
      },
      "reading-summaries.json": {
        "additionalProperties": true,
        "properties": {},
        "required": [
          "units"
        ],
        "type": "object"
      },
      "basic-block-details.json": {
        "additionalProperties": true,
        "properties": {},
        "required": [
          "nodes",
          "blocks",
          "node_sources"
        ],
        "type": "object"
      },
      "stage6/principle-lineage.json": {
        "additionalProperties": true,
        "properties": {
          "relations": {
            "items": {},
            "type": "array"
          }
        },
        "required": [
          "relations"
        ],
        "type": "object"
      }
    },
    "S7": {
      "stage7/acceptance.json": {
        "additionalProperties": true,
        "properties": {},
        "required": [
          "passed",
          "checks",
          "counts",
          "browser_checked",
          "semantic_review_unresolved"
        ],
        "type": "object"
      },
      "stage7/model-check.json": {
        "properties": {
          "ownerContradictions": {
            "const": 0
          },
          "passed": {
            "const": true
          },
          "unaccountedCalls": {
            "const": 0
          }
        },
        "required": [
          "passed",
          "unaccountedCalls",
          "ownerContradictions"
        ],
        "type": "object"
      }
    },
    "S8": {}
  }
}
