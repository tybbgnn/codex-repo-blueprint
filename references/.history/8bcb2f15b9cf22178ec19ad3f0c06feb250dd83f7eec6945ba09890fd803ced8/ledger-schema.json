{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage2 semantic ownership ledger",
  "type": "object",
  "required": [
    "schema_version",
    "root",
    "phase_order",
    "nodes",
    "technical",
    "selection",
    "granularity"
  ],
  "properties": {
    "semantic_action_ids": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "migration": {
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "root": {
      "type": "string"
    },
    "phase_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "members",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "basic_block_order": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "bb_annotations": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          },
          "kind": {
            "enum": [
              "root",
              "phase",
              "goal",
              "action",
              "bb_group"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "members": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          },
          "adds": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "technical": {
      "type": "array"
    },
    "selection": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "disposition"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "disposition": {
                "enum": [
                  "shown",
                  "technical",
                  "folded"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "semanticRole": {
                "enum": [
                  "business",
                  "adapter"
                ]
              },
              "sourceRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ownerActionRef": {
                "type": "string"
              }
            }
          }
        },
        "foldRules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "targetCategory",
              "reason"
            ],
            "properties": {
              "targetCategory": {
                "enum": [
                  "std",
                  "third_party"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "granularity": {
      "type": "object",
      "required": [
        "technicalBlocks",
        "goalContracts"
      ],
      "properties": {
        "technicalBlocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "bbRef",
              "category",
              "reason",
              "evidenceRefs"
            ],
            "properties": {
              "bbRef": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "evidenceRefs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "factSha256": {
                "type": "string",
                "minLength": 64
              },
              "blockRole": {
                "type": "string"
              },
              "eventMacroProof": {
                "type": "object"
              },
              "operationReasons": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "terminatorReason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "goalContracts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "goalRef",
              "contractRef",
              "entryMode",
              "completion",
              "cohesionReason",
              "evidenceRefs",
              "memberContracts"
            ],
            "properties": {
              "goalRef": {
                "type": "string",
                "minLength": 1
              },
              "contractRef": {
                "type": "string",
                "minLength": 1
              },
              "targetRef": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "receiverRef": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "entryMode": {
                "type": "string",
                "minLength": 1
              },
              "completion": {
                "type": "string",
                "minLength": 1
              },
              "cohesionReason": {
                "type": "string",
                "minLength": 1
              },
              "evidenceRefs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "memberContracts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "actionRef",
                    "contractRef",
                    "entryMode",
                    "evidenceRefs"
                  ],
                  "properties": {
                    "actionRef": {
                      "type": "string",
                      "minLength": 1
                    },
                    "contractRef": {
                      "type": "string",
                      "minLength": 1
                    },
                    "entryMode": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidenceRefs": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
